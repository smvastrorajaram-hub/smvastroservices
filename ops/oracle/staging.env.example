# Create /etc/smvastroservices/staging.env from this template.
# Staging must point only to the isolated staging Firebase project and Razorpay Test Mode.
NODE_ENV=staging
HOST=127.0.0.1
PORT=10001
PUBLIC_BACKEND_URL=https://api-staging.smvastroservices.in

FIREBASE_PROJECT_ID=smv-astro-staging
FIREBASE_STORAGE_BUCKET=smv-astro-staging.firebasestorage.app
FIREBASE_CLIENT_EMAIL=REPLACE_STAGING_FIREBASE_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY=REPLACE_WITH_STAGING_PRIVATE_KEY_NEWLINE_ESCAPED

ADMIN_UID=
ADMIN_UIDS=
ADMIN_AUTH_EMAILS=
ADMIN_EMAIL=REPLACE_STAGING_NOTIFICATION_EMAIL
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE_STAGING_RAZORPAY_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_STAGING_WEBHOOK_SECRET
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_RECIPIENT=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PHONE_VERIFICATION_MODE=email_unique
WHATSAPP_OTP_PROVIDER=
FCM_VAPID_PUBLIC_KEY=
LIVE_TURN_URL=REPLACE_STAGING_IF_CONFIGURED
LIVE_TURN_URLS=
LIVE_TURN_SHARED_SECRET=REPLACE_STAGING_IF_CONFIGURED
GEONAMES_USERNAME=REPLACE_GEONAMES_USERNAME
PUBLIC_SITE_URL=https://staging.smvastroservices.in
ALLOWED_ORIGINS=https://staging.smvastroservices.in,https://api-staging.smvastroservices.in

SWISSEPH_EPHE_PATH=/opt/smvastroservices/shared/ephe
HOUSE_SYSTEM=S
SMV_FIRESTORE_MULTI_PROJECT_ENABLED=false
SMV_WALLET_DOMAIN_ENABLED=false
SMV_P23_READ_FAILOVER_COMPLETE=false
SMV_P45_READ_FAILOVER_COMPLETE=false
