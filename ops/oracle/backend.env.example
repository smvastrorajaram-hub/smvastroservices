# COPY this template to /etc/smvastroservices/production.env or staging.env.
# Replace every REPLACE_* value out-of-band. Never commit real secrets.
# EnvironmentFile is read by systemd; keep the private key in a single line with
# literal \\n separators or as an EnvironmentFile-compatible quoted multiline value.
NODE_ENV=production
HOST=127.0.0.1
PORT=10000
PUBLIC_BACKEND_URL=https://api.smvastroservices.in

FIREBASE_PROJECT_ID=smv-astro
FIREBASE_STORAGE_BUCKET=smv-astro.firebasestorage.app
FIREBASE_CLIENT_EMAIL=REPLACE_FIREBASE_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY=REPLACE_WITH_PRIVATE_KEY_NEWLINE_ESCAPED

# Existing app secrets: copy from the trusted secret store securely; do not rotate here.
ADMIN_UID=REPLACE_ADMIN_UID
ADMIN_UIDS=
ADMIN_AUTH_EMAILS=REPLACE_ADMIN_EMAIL
ADMIN_EMAIL=REPLACE_NOTIFICATION_EMAIL
RAZORPAY_KEY_ID=REPLACE_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_RAZORPAY_WEBHOOK_SECRET
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_RECIPIENT=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PHONE_VERIFICATION_MODE=email_unique
WHATSAPP_OTP_PROVIDER=
FCM_VAPID_PUBLIC_KEY=
LIVE_TURN_URL=
LIVE_TURN_URLS=
LIVE_TURN_SHARED_SECRET=
GEONAMES_USERNAME=REPLACE_GEONAMES_USERNAME
PUBLIC_SITE_URL=https://smvastroservices.in
ALLOWED_ORIGINS=https://smvastroservices.in,https://www.smvastroservices.in,https://smvastroservices.pages.dev,https://horoscope.smvastroservices.in,https://calendar.smvastroservices.in

SWISSEPH_EPHE_PATH=/opt/smvastroservices/shared/ephe
HOUSE_SYSTEM=S

# Multi-project Firestore remains opt-in until the Firebase migration's own backfill,
# reconciliation and staged verification are complete. Do not set rollout flags here.
SMV_FIRESTORE_MULTI_PROJECT_ENABLED=false
SMV_WALLET_DOMAIN_ENABLED=false
SMV_P23_READ_FAILOVER_COMPLETE=false
SMV_P45_READ_FAILOVER_COMPLETE=false
