[Unit]
Description=SMV ASTRO staging backend (Oracle Cloud Infrastructure)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smvastro
Group=smvastro
WorkingDirectory=/opt/smvastroservices/staging
EnvironmentFile=/etc/smvastroservices/staging.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
