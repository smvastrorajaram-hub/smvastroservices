{
  "name": "smvastroservices",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "SMV_ENVIRONMENT": "production",
    "SMV_BACKEND_CLOUDFLARE_ACTIVE": "true",
    "FIREBASE_PROJECT_ID": "smv-astro",
    "FIREBASE_AUTH_PROJECT_IDS": "smv-astro",
    "SMV_CONFIGURED_ADMIN_UIDS": "TwjeEIFS3Zcf1SxboLZoujm91Ky2",
    "SMV_WALLET_BACKFILL_TOOLS_ENABLED": "false",
    "SMV_WALLET_DOMAIN_QUIESCED": "false",
    "SMV_WALLET_DOMAIN_BACKFILL_COMPLETE": "true",
    "SMV_WALLET_DOMAIN_CUTOVER_COMPLETE": "true",
    "WALLET_READ_ROUTES_ENABLED": "true",
    "SMV_WALLET_PAYOUT_KEY_VERSION": "v1",
    "SMV_IDENTITY_PROFILE_BACKFILL_ENABLED": "false",
    "SMV_IDENTITY_PROFILE_CUTOVER_COMPLETE": "true",
    "SMV_IDENTITY_PROFILE_BACKFILL_PREVIEW_ONLY": "true",
    "SMV_IDENTITY_PROFILE_D1_AUTHORIZATION_ENABLED": "true",
    "SMV_IDENTITY_PROFILE_PRODUCTION_AUTHORIZATION_APPROVED": "true",
    "SMV_IDENTITY_PROFILE_FRESH_START_APPROVED": "true",
    "SMV_LIVE_SESSION_ROUTES_ENABLED": "true",
    "SMV_RAZORPAY_LIVE_MODE_ENABLED": "true",
    "SMV_RAZORPAY_TEST_MODE_ENABLED": "false",
    "SMV_NEW_QUESTION_PAYMENTS_ENABLED": "false",
    "SMV_LEGACY_PRIVATE_CONSULTATION_ENABLED": "false",
    "SMV_PUBLIC_BACKEND_URL": "https://smvastroservices.astroservices.workers.dev",
    "ALLOWED_ORIGINS": "https://smvastroservices.in"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smvastro-wallet-production",
      "database_id": "b1d5684c-3fcd-48fe-9571-ea41fc605c7d",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_SESSION_COORDINATOR", "class_name": "LiveSessionCoordinator" },
      { "name": "LIVE_USER_EVENT_HUB", "class_name": "LiveUserEventHub" }
    ]
  },
  "migrations": [
    {
      "tag": "v1_live_session_coordinator",
      "new_sqlite_classes": ["LiveSessionCoordinator", "LiveUserEventHub"]
    }
  ]
}
