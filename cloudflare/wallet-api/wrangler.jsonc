{
  "name": "smvastro-wallet-api-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SMV_ENVIRONMENT": "staging",
    "SMV_WALLET_CLOUDFLARE_ACTIVE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smvastro-wallet-staging",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
