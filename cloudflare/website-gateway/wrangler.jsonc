{
  "name": "smvastro-website-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SMV_ENVIRONMENT": "staging",
    "RENDER_WEBSITE_ORIGIN": "https://smv-astro-phase1-browser-staging-v2.onrender.com",
    "PRODUCTION_TRAFFIC_ENABLED": "false"
  }
}
